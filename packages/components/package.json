{
  "name": "react-bio-viz",
  "version": "0.3.0",
  "description": "React components for biological data visualization",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holmrenser/react-bio-viz.git",
    "directory": "packages/components"
  },
  "author": "rens holmer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/holmrenser/react-bio-viz/issues"
  },
  "homepage": "https://github.com/holmrenser/react-bio-viz#readme",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.es.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.es.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "module": "./dist/main.es.js",
  "main": "./dist/main.cjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && vite build --mode utils && node scripts/check-ssr.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.47.0",
    "@react-bio-viz/core": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "betula-schema": "^0.6.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.4",
    "vitest-canvas-mock": "^0.3.3"
  }
}
