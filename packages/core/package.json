{
  "name": "@react-bio-viz/core",
  "version": "0.1.0",
  "description": "Shared primitives for react-bio-viz: controllable state, viewport pan/zoom, color palettes, coordinate scales, and shadcn/ui-based UI chrome",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genenotebook/react-bio-viz.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.es.js",
      "default": "./dist/main.cjs.js"
    },
    "./style.css": "./dist/style.css"
  },
  "module": "./dist/main.es.js",
  "main": "./dist/main.cjs.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "docs:extract": "api-extractor run --local --verbose"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.47.0",
    "@tailwindcss/vite": "^4.0.0-beta.7",
    "@testing-library/react": "^16.0.1",
    "@types/color": "^3.0.6",
    "@types/node": "^20.14.9",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cn": "^0.3.3",
    "color": "^4.2.3",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "randomcolor": "^0.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.0.0-beta.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.4",
    "zustand": "^5.0.1"
  }
}
