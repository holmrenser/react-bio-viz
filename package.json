{
  "name": "react-bio-viz-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for react-bio-viz: reusable, controllable React components for biological data visualization",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genenotebook/react-bio-viz.git"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* typecheck",
    "lint": "pnpm -r --filter=./packages/* --filter=./apps/* lint",
    "dev": "pnpm --filter apps/demo dev",
    "docs": "pnpm --filter @react-bio-viz/components docs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
