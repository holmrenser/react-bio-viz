{
  "name": "react-bio-viz-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for react-bio-viz: reusable, controllable React components for biological data visualization",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genenotebook/react-bio-viz.git"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "test": "pnpm -r --filter=./packages/* test",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* typecheck",
    "lint": "pnpm -r --filter=./packages/* --filter=./apps/* lint",
    "dev": "pnpm --filter ./apps/demo dev",
    "docs": "pnpm build && pnpm --filter @react-bio-viz/docs build",
    "docs:dev": "pnpm --filter @react-bio-viz/docs dev"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
